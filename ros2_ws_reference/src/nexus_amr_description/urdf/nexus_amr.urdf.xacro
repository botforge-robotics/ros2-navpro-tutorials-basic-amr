<?xml version="1.0"?>
<robot name="nexus_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================= -->
  <!-- INCLUDES: Materials & Gazebo Simulation Plugins                         -->
  <!-- ======================================================================= -->
  <xacro:include filename="$(find nexus_amr_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find nexus_amr_description)/urdf/gazebo_plugins.xacro" />

  <!-- ======================================================================= -->
  <!-- BASE FOOTPRINT: Ground plane projection (Z=0, REP-103 / REP-105)        -->
  <!-- ======================================================================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================================= -->
  <!-- BASE LINK: Main Chassis Body from Fusion 360 CAD Model                  -->
  <!-- ======================================================================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.001469176771838543 0.0003790265380710722 0.03507288297524478" rpy="0 0 0"/>
      <mass value="0.6558055651572491"/>
      <inertia ixx="0.000584" iyy="0.002255" izz="0.002722" ixy="-0.0" iyz="0.0" ixz="-3.3e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!-- 2D RPLIDAR SENSOR: 360-Degree Laser Scanner Mount                       -->
  <!-- ======================================================================= -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.066117 0.000379 0.06" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_1"/>
  </joint>

  <link name="lidar_1">
    <inertial>
      <origin xyz="-3.4149261791960317e-07 2.653609604535284e-08 0.004584263465868918" rpy="0 0 0"/>
      <mass value="0.015296318351217206"/>
      <inertia ixx="2e-06" iyy="2e-06" izz="3e-06" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.066117 -0.000379 -0.06" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="-0.066117 -0.000379 -0.06" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!-- RGB CAMERA SENSOR: Front Perception Camera Mount                        -->
  <!-- ======================================================================= -->
  <joint name="cam_joint" type="fixed">
    <origin xyz="0.101117 0.000379 0.035" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_1"/>
  </joint>

  <link name="camera_1">
    <inertial>
      <origin xyz="0.0013792199193853605 2.653621699200831e-08 -1.3877787807814457e-16" rpy="0 0 0"/>
      <mass value="0.0003431856271826569"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.101117 -0.000379 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.101117 -0.000379 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!-- RIGHT DRIVE WHEEL: Actuated continuous joint                            -->
  <!-- ======================================================================= -->
  <joint name="right_motor" type="continuous">
    <origin xyz="0.056117 -0.051621 0.035" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_1"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <link name="right_wheel_1">
    <inertial>
      <origin xyz="-3.4101172063927265e-07 -0.004999972863944609 2.3592239273284576e-16" rpy="0 0 0"/>
      <mass value="0.03579059430602171"/>
      <inertia ixx="1.1e-05" iyy="2.2e-05" izz="1.1e-05" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.056117 0.051621 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.056117 0.051621 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!-- LEFT DRIVE WHEEL: Actuated continuous joint                             -->
  <!-- ======================================================================= -->
  <joint name="left_motor" type="continuous">
    <origin xyz="0.056117 0.052379 0.035" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_1"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <link name="left_wheel_1">
    <inertial>
      <origin xyz="-3.410117210139729e-07 0.005000027136054359 -1.457167719820518e-16" rpy="0 0 0"/>
      <mass value="0.03579059430602171"/>
      <inertia ixx="1.1e-05" iyy="2.2e-05" izz="1.1e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.056117 -0.052379 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.056117 -0.052379 -0.035" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nexus_amr_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!-- PASSIVE CASTER WHEEL: Balance point preventing pitching/dragging        -->
  <!-- ======================================================================= -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="4.5e-06" ixy="0.0" ixz="0.0" iyy="4.5e-06" iyz="0.0" izz="4.5e-06"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.08 0 0.01" rpy="0 0 0"/>
  </joint>

</robot>
