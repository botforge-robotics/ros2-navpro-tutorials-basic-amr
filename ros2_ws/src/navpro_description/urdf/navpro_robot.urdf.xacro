<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="navpro_mini">

  <!-- ========================================== -->
  <!-- INCLUDES -->
  <!-- ========================================== -->
  <xacro:include filename="$(find navpro_description)/urdf/lidar.xacro" />
  <xacro:include filename="$(find navpro_description)/urdf/imu.xacro" />
  <xacro:include filename="$(find navpro_description)/urdf/gazebo_plugins.xacro" />

  <!-- ========================================== -->
  <!-- CONSTANTS & PROPERTIES -->
  <!-- ========================================== -->
  <xacro:property name="chassis_length" value="0.40" />
  <xacro:property name="chassis_width" value="0.30" />
  <xacro:property name="chassis_height" value="0.14" />
  <xacro:property name="chassis_mass" value="8.0" />

  <xacro:property name="wheel_radius" value="0.06" />
  <xacro:property name="wheel_width" value="0.035" />
  <xacro:property name="wheel_separation" value="0.32" />
  <xacro:property name="wheel_mass" value="0.8" />

  <xacro:property name="caster_radius" value="0.03" />
  <xacro:property name="caster_mass" value="0.3" />

  <!-- ========================================== -->
  <!-- MATERIALS -->
  <!-- ========================================== -->
  <material name="navpro_cyan">
    <color rgba="0.0 0.75 0.9 1.0" />
  </material>

  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0" />
  </material>

  <!-- ========================================== -->
  <!-- INERTIAL MACROS -->
  <!-- ========================================== -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * m * (r*r)}" iyz="0.0"
               izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================== -->
  <!-- BASE FOOTPRINT (Ground projection) -->
  <!-- ========================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ========================================== -->
  <!-- BASE LINK (Chassis body) -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="navpro_cyan" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}" />
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Turquoise</material>
  </gazebo>

  <!-- ========================================== -->
  <!-- LEFT DRIVE WHEEL -->
  <!-- ========================================== -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 ${wheel_separation/2} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- ========================================== -->
  <!-- RIGHT DRIVE WHEEL -->
  <!-- ========================================== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 ${-wheel_separation/2} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- ========================================== -->
  <!-- FRONT CASTER WHEEL (Frictionless ball) -->
  <!-- ========================================== -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="dark_gray" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_caster_link" />
    <origin xyz="0.14 0 ${-wheel_radius + caster_radius}" rpy="0 0 0" />
  </joint>

  <gazebo reference="front_caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ========================================== -->
  <!-- REAR CASTER WHEEL (Frictionless ball) -->
  <!-- ========================================== -->
  <link name="rear_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="dark_gray" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_caster_link" />
    <origin xyz="-0.14 0 ${-wheel_radius + caster_radius}" rpy="0 0 0" />
  </joint>

  <gazebo reference="rear_caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

</robot>
